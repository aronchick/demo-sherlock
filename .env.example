# Point any agent at any OpenAI-compatible endpoint. Ollama locally, vLLM on Brev later.
DIRECTOR_BASE_URL=http://localhost:11434/v1
DIRECTOR_MODEL=nemotron-3.5-lightning     # ollama pull nemotron-3.5-lightning (30B-A3B, ~18GB Q4)
DIRECTOR_THINKING=0                        # 1 = Lightning reasoning mode (slower)
ANALYST_BASE_URL=http://localhost:11434/v1
ANALYST_MODEL=qwen2.5vl:3b
VERIFIER_BASE_URL=http://localhost:11434/v1
VERIFIER_MODEL=qwen2.5vl:3b
OPENAI_API_KEY=ollama

# scout: mock | yolo
SCOUT_BACKEND=yolo
YOLO_MODEL=yolov8n.pt

# cameras: comma list of "name:backend:source"
#   backend = fake (crop/zoom on a flat webcam or video file) | obsbot (UVC PTZ)
#   source  = device index or video path
CAMERAS=hero:fake:0,scout1:fake:1

# --- Brev + vLLM (run brev/serve.sh on the GPU box, then uncomment) ---
# DIRECTOR_BASE_URL=http://<brev-host>:8001/v1
# DIRECTOR_MODEL=director
# ANALYST_BASE_URL=http://<brev-host>:8002/v1
# ANALYST_MODEL=vlm
# VERIFIER_BASE_URL=http://<brev-host>:8002/v1
# VERIFIER_MODEL=vlm
