# Point any agent at any OpenAI-compatible endpoint.
# Default Configuration A (vLLM on Brev or SSH tunnel):
#   Director: nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4 (thinking off)
#   Lightning: 30B by model card / 31.58B by tensor count, 3B active.
#   MTP heads (1.34B) are not loaded with the current speculation-off config.
#   Analyst + Verifier: shared HuggingFaceTB/SmolVLM-Instruct (2.25B, Idefics3 arch in vLLM)
#   Total generative params: 32.25B by model card / 33.82B by tensor count (over the 33B cap).
DIRECTOR_BASE_URL=http://localhost:8001/v1
DIRECTOR_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
DIRECTOR_THINKING=0                        # 0 = off (low-latency tool loop), 1 = Lightning reasoning mode
ANALYST_BASE_URL=http://localhost:8002/v1
ANALYST_MODEL=HuggingFaceTB/SmolVLM-Instruct
VERIFIER_BASE_URL=http://localhost:8002/v1
VERIFIER_MODEL=HuggingFaceTB/SmolVLM-Instruct
# Optional Verifier log-odds threshold override (defaults: 0.56 for SmolVLM-Instruct, 3.31 for SmolVLM-500M-Instruct)
# VERIFIER_MARGIN=0.56
OPENAI_API_KEY=ollama

# Demo/recording dashboard: keep live camera feeds and face crops on this Mac.
# Override with 0.0.0.0 only on a trusted network to allow LAN access.
DASHBOARD_HOST=127.0.0.1

# scout: mock | yolo (yolov8n.pt is a 3.2M non-generative detector, excluded from generative budget)
SCOUT_BACKEND=yolo
YOLO_MODEL=yolov8n.pt

# cameras: comma list of "name:backend:source"
#   backend = fake (crop/zoom on a flat webcam or video file) | insta360 (Link 2 USB PTZ) | obsbot (UVC PTZ)
#   source  = device index, "name:<camera name>", or video path
CAMERAS=hero:fake:0,scout1:fake:1

# --- Configuration A: Brev + vLLM (run brev/serve.sh on the GPU box, then uncomment) ---
# Total generative params: 32.25B by model card / 33.82B by tensor count.
# Lightning: 30B card / 31.58B tensors + 2.25B shared VLM; MTP (1.34B) not loaded.
# The tensor count exceeds the 33B cap. To stay <= 33B under both counts (30.51B card / 32.09B tensors),
# set ANALYST_MODEL and VERIFIER_MODEL to HuggingFaceTB/SmolVLM-500M-Instruct. See README's parameter-budget section.
# DIRECTOR_BASE_URL=http://<brev-host>:8001/v1
# DIRECTOR_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# DIRECTOR_THINKING=0
# ANALYST_BASE_URL=http://<brev-host>:8002/v1
# ANALYST_MODEL=HuggingFaceTB/SmolVLM-Instruct
# VERIFIER_BASE_URL=http://<brev-host>:8002/v1
# VERIFIER_MODEL=HuggingFaceTB/SmolVLM-Instruct

# --- Configuration B: NeMo Gym ablation (~17.6B–21.0B total, loses Lightning bounty) ---
# Trades the 30B-A3B Lightning Director for a 9B–12B Nano Director so the shared VLM can step up
# to 8.72B Nemotron Nano VL without breaking the budget (mixing 30B Lightning + 8B VLM = ~38.7B, over budget).
# On Brev: DIRECTOR=nvidia/NVIDIA-Nemotron-Nano-9B-v2 VLM=nvidia/Llama-3.1-Nemotron-Nano-VL-8B-V1 ./brev/serve.sh
# DIRECTOR_BASE_URL=http://<brev-host>:8001/v1
# DIRECTOR_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2          # 8.89B (or nvidia/NVIDIA-Nemotron-Nano-12B-v2, 12.31B)
# DIRECTOR_THINKING=0
# ANALYST_BASE_URL=http://<brev-host>:8002/v1
# ANALYST_MODEL=nvidia/Llama-3.1-Nemotron-Nano-VL-8B-V1      # 8.72B shared by Analyst + Verifier
# VERIFIER_BASE_URL=http://<brev-host>:8002/v1
# VERIFIER_MODEL=nvidia/Llama-3.1-Nemotron-Nano-VL-8B-V1
